# ============================================================
# Yog Board Portal — environment configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# ---- Supabase (create a NEW project at https://supabase.com) ----
# Server-side (keep secret!)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Client-side (safe to expose — this is the publishable key)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# ---- Admin session signing (generate: openssl rand -base64 48) ----
SESSION_SECRET=change-me-to-a-long-random-string

# ---- First-time super admin bootstrap password ----
# Used ONLY when the superadmin account has no password hash yet.
# The superadmin is forced to set a real password on first login.
ADMIN_PASSWORD=change-me-bootstrap-password

# ---- Optional: Super Admin password recovery key (min 16 chars) ----
# If unset, ADMIN_PASSWORD (then SESSION_SECRET) is used as fallback.
ADMIN_RESET_KEY=
